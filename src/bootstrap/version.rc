// The mark an installer reads to tell this shfolder.dll from another mod's (design section 11):
// ProductName "RoN Plugin Loader" and its version. Keep FILEVERSION and the strings in step with
// RON_API_MAJOR / RON_API_MINOR (include/ron_plugin.h): major.minor of the API, then the build.
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x2
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RoN Plugin Loader"
            VALUE "FileDescription", "RoN Plugin Loader (in place of shfolder.dll)"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "RonPluginLoader"
            VALUE "OriginalFilename", "shfolder.dll"
            VALUE "ProductName", "RoN Plugin Loader"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
