// The mark an installer reads to tell this shfolder.dll from another mod's (design section 11):
// ProductName "RoN Plugin Loader" and its version, taken from src/common/version.h.
#include "../common/version.h"

1 VERSIONINFO
FILEVERSION LOADER_VERSION_MAJOR,LOADER_VERSION_MINOR,LOADER_VERSION_PATCH,0
PRODUCTVERSION LOADER_VERSION_MAJOR,LOADER_VERSION_MINOR,LOADER_VERSION_PATCH,0
FILEOS 0x40004
FILETYPE 0x2
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RoN Plugin Loader"
            VALUE "FileDescription", "RoN Plugin Loader (in place of shfolder.dll)"
            VALUE "FileVersion", LOADER_VERSION_STRING
            VALUE "InternalName", "RonPluginLoader"
            VALUE "OriginalFilename", "shfolder.dll"
            VALUE "ProductName", "RoN Plugin Loader"
            VALUE "ProductVersion", LOADER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
